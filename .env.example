# Скопировать в .env и поправить под окружение.
#     cp .env.example .env && docker compose up -d --build

# --- сервис сопоставления (сканер этикеток) ---------------------------------
# Адрес сервиса, в котором живёт весь пайплайн: кадрирование, чтение этикетки
# моделью, сопоставление с каталогом. Это отдельный контейнер из репозитория
# сканера; здесь только его адрес.
#
# Пусто — сканер деградирует до поиска по подстроке и честно говорит, что
# распознавание недоступно. Приложение при этом работает целиком.
#
#   тот же хост, рядом в docker:   http://scanner:8080
#   отдельная машина:              https://scanner.example.ru
MATCHER_URL=

# Продуктовая ручка, а не судейская: умеет воздержаться и вернуть топ-5.
MATCHER_PATH=/v1/predict

# Сколько ждать ответа. Матчер отвечает за 1.5 с на GPU рядом и за 6-7 с
# через serverless; 15 с — это запас, а не ожидаемое время.
MATCHER_TIMEOUT_MS=15000

# --- база --------------------------------------------------------------------
POSTGRES_USER=vinora
POSTGRES_PASSWORD=vinora
POSTGRES_DB=vinora
